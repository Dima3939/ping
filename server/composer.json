{
  "name": "ping/backend",
  "type": "project",
  "description": "Ping — Real-Time WebSocket API Server powered by Laravel 11 & Reverb",
  "keywords": ["laravel", "reverb", "websockets", "realtime", "chat"],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "laravel/reverb": "^1.0",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^2.9"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
